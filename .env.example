# Copy to .env.local and fill in what you need.
# Everything degrades safely: IGDB search and the AI Guide return explicit 503s
# when their credentials are absent, and every other feature stays live.

# --- Database (Neon injects both automatically on Vercel) ---
DATABASE_URL=postgresql://user:password@localhost:5432/savepoint
# Direct (non-pooled) connection used by `prisma migrate`.
DATABASE_URL_UNPOOLED=

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_ALGORITHMS=RS256
# Skips JWT verification and treats every request as DEV_AUTH_SUB.
# Refused outside the development/test environments.
DEV_AUTH_BYPASS=false
DEV_AUTH_SUB=auth0|local-developer

# --- IGDB (via Twitch) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: a pre-minted user token used instead of client credentials.
TWITCH_USER_TOKEN=

# --- AI Guide ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Media uploads (Vercel Blob injects this automatically) ---
BLOB_READ_WRITE_TOKEN=

# --- Privacy + rate limiting ---
# HMAC key for hashed rate-limit identities. Generate with: openssl rand -hex 32
IP_HASH_SECRET=
GUIDE_RATE_LIMIT=10
GUIDE_RATE_WINDOW_SECONDS=3600
IGDB_RATE_LIMIT=60
UPLOAD_RATE_LIMIT=30
MAX_UPLOAD_BYTES=10485760

# --- Deployment metadata ---
SITE_URL=https://savepointarchive.vercel.app
# Overrides the API base used by the OG-card and crawler-HTML functions.
SAVEPOINT_API_URL=
