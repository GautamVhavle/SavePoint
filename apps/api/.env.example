ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/savepoint
CORS_ORIGINS=["http://localhost:3000"]
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.savepoint.example
AUTH0_ALGORITHMS=["RS256"]
DEV_AUTH_BYPASS=false
DEV_AUTH_SUB=auth0|local-developer
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Public (secretless) Twitch app alternative: paste a device-flow user token
# generated via scripts/twitch_device_auth.py. Takes precedence over the secret.
TWITCH_USER_TOKEN=
SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=savepoint-media
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
IP_HASH_SECRET=replace-with-at-least-32-random-characters
GUIDE_RATE_LIMIT=10
GUIDE_RATE_WINDOW_SECONDS=3600
IGDB_RATE_LIMIT=60
UPLOAD_RATE_LIMIT=30
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
