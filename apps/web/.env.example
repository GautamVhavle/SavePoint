# FastAPI base URL. Omit locally to use safe visual demo data.
VITE_API_URL=http://localhost:8000/api/v1

# Auth0 SPA settings. These are public client identifiers, never secrets.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.savepoint.example

# Public read base for uploaded media (must match API storage settings).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_BUCKET=savepoint-media

# Server-side only (Vercel functions, never bundled for the browser):
# SAVEPOINT_API_URL=https://your-api.example.com/api/v1
# SITE_URL=https://savepoint.vercel.app

# Explicit local showcase mode. Never grants API authorization.
VITE_DEMO_MODE=false
